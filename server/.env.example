PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mech-shop
# Database name passed to Mongoose. Without it (and without a name in the URI)
# MongoDB uses the "test" database. For Atlas keep this as mech-shop.
MONGO_DB_NAME=mech-shop
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
CLIENT_ORIGIN=http://localhost:5173

# Used only by `npm run seed` to create the single admin account
ADMIN_NAME=Shop Admin
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change-me-now
